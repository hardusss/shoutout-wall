# mainnet-beta (default) or devnet
NEXT_PUBLIC_CLUSTER=devnet

# A dedicated RPC is strongly recommended. The public mainnet RPC rate-limits.
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional: websocket endpoint, if it differs from the RPC URL
# NEXT_PUBLIC_WS_URL=

# Optional: public origin for the QR code (e.g. when the wall itself runs on localhost)
# NEXT_PUBLIC_SITE_URL=https://shoutout.example.com
